@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Identity.EntityFrameworkCore
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<div class="navbar-user-area ms-auto d-flex align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    <div class="dropdown">
        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="user-icon" style="font-size:1.3rem;margin-right:8px;">&#128100;</span>
            <span>@UserManager.GetUserName(User)</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
            <li>
                <form asp-area="Identity" asp-page="/Account/Logout" method="post" id="logoutForm" class="form-inline m-0">
                    <button type="submit" class="dropdown-item">Logout</button>
                </form>
            </li>
        </ul>
    </div>
}
else
{
    <a class="nav-link me-2" asp-area="Identity" asp-page="/Account/Login">Login</a>
    <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a>
}
</div> 