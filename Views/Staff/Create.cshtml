@model EMSCore.Models.Staff
@{
    ViewData["Title"] = "Add New Staff";
}
<div class="page-card">
    <h2 class="page-title">Add New Staff</h2>
    @if (ViewData.ModelState != null && !ViewData.ModelState.IsValid)
    {
        <div class="alert-danger validation-summary">
            Please correct the errors below and try again.
        </div>
    }
    <form asp-action="Create" method="post" novalidate>
        <div class="form-group mb-3">
            <label class="form-label">Name:</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label class="form-label">Email:</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="form-group mb-4">
            <label class="form-label">Phone:</label>
            <input asp-for="Phone" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>
        <button class="nav-btn primary-btn" type="submit">Add Staff</button>
    </form>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
