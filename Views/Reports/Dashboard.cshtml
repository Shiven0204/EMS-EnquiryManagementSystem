@{
    ViewData["Title"] = "Analytics Dashboard";
    var sourceCounts = ViewBag.SourceCounts as IEnumerable<dynamic>;
    int total = ViewBag.TotalEnquiries ?? 0;
    int converted = ViewBag.Converted ?? 0;
    int dropped = ViewBag.Dropped ?? 0;
}
<h2>Analytics Dashboard</h2>
<div class="dashboard-cards">
    <div class="card">Total Enquiries<br /><span>@total</span></div>
    <div class="card">Converted<br /><span>@converted</span></div>
    <div class="card">Dropped<br /><span>@dropped</span></div>
</div>
<div class="chart-container">
    <canvas id="enquiryChart" width="400" height="220"></canvas>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    var data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(sourceCounts));
    var ctx = document.getElementById('enquiryChart').getContext('2d');
    var chart = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: data.map(x => x.Source),
            datasets: [{
                label: 'Enquiries by Source',
                data: data.map(x => x.Count),
                backgroundColor: ['#4c3a7c', '#8e56af', '#cf9369', '#e1daf0', '#4c3a7c'],
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false }
            },
            scales: {
                y: { beginAtZero: true }
            }
        }
    });
</script>
<style>
.dashboard-cards {
    display: flex;
    gap: 20px;
    margin-bottom: 30px;
}
.card {
    background: #8e56af;
    color: #fff;
    padding: 18px 32px;
    border-radius: 10px;
    font-size: 1.2em;
    text-align: center;
    min-width: 120px;
}
.card span {
    font-size: 2em;
    font-weight: bold;
    display: block;
    margin-top: 8px;
}
.chart-container { max-width: 500px; margin: 32px auto; background: #e1daf0; border-radius: 12px; padding: 24px; }
</style>
