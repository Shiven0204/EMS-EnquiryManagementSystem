@model EMSCore.Models.FollowUp
@{
    ViewData["Title"] = "Add Follow-Up";
}
<h2>Add Follow-Up</h2>
@if (ViewBag.Message != null) {
    <div class="alert-success">@ViewBag.Message</div>
}
<form asp-action="Add" method="post">
    <input type="hidden" asp-for="EnquiryId" />
    <div class="form-group">
        <label>Staff ID:</label>
        <input asp-for="StaffId" class="form-control" />
    </div>
    <div class="form-group">
        <label>Date & Time:</label>
        <input asp-for="Date" class="form-control" type="datetime-local" />
    </div>
    <div class="form-group">
        <label>Note:</label>
        <textarea asp-for="Note" class="form-control"></textarea>
    </div>
    <div class="form-group">
        <label>Reminder Sent:</label>
        <input asp-for="ReminderSent" type="checkbox" />
    </div>
    <button class="nav-btn" type="submit">Add Follow-Up</button>
</form>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
